# ============================================================================
# Detecture monorepo — root .gitignore
# ============================================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.venv/
venv/
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- Model weights ----------
# The canonical checkpoint ships via Hugging Face, not git. The only artifact
# git tracks is a placeholder pointer file (see README for the download URL).
*.pt
*.pth
*.ckpt
*.safetensors
!**/checkpoints/best.pt.README.md

# ---------- Datasets ----------
# Datasets are fetched from Hugging Face (see root README §Datasets). Users
# symlink or copy them under ~/datasets/<DATASET>/ or set DETECTURE_DATASETS_ROOT.
datasets/
~/datasets/

# ---------- Eval outputs ----------
# Per-run artifacts — regenerated by master_runner.py.
**/results/logs/
**/results/**/vis/
**/results/**/*.png
**/results/paper_benchmark_summary.json
**/results/runner_summary.json
**/results/summary.csv
**/checkpoints/test_results/
**/checkpoints/logs/
**/checkpoints/plots/
**/checkpoints/sanity/

# ---------- Local-only project folders (NEVER push) ----------
/Detecture_paper/
/Detecture_documents/

# ---------- IDE / OS ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ---------- LaTeX build artifacts ----------
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.pdf
!docs/**/*.pdf

# ---------- wandb / mlflow ----------
wandb/
mlruns/

# ---------- DetectureMiner heavy artifacts (generated / raw data) ----------
DetectureMiner/data/
DetectureMiner/docs/review/
DetectureMiner/docs/auto/
DetectureMiner/site_exports/
DetectureMiner/progress/diagnostics/
DetectureMiner/rwtd_miner/**/_cache/
DetectureMiner/_smoke/
DetectureMiner/pilot100_run/
DetectureMiner/ade20k_eval/
DetectureMiner/ade20k_eval_multimodal/
DetectureMiner/calibration_rwtd/
DetectureMiner/review_ade_rwtd/
DetectureMiner/review_ade_rwtd_test/
DetectureMiner/.tmp/
DetectureMiner/**/*.log
DetectureMiner/**/*.mmap
DetectureMiner/.cache/
